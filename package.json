{
  "name": "dsh-usage-insights",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Token usage, estimated cost and budget across real sessions, with a consumption timeline, per-session breakdown, and live CPU monitoring.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "usage",
    "tokens",
    "cost",
    "budget",
    "cpu",
    "sidebar"
  ]
}
